{
    "compilerOptions": {
      "target": "ES2022",
      "module": "Node16",
      "moduleResolution": "Node16",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "outDir": "dist",
      "types": ["node", "jest"]
    },
    "include": [
      "config/**/*.ts",
      "api/**/*.ts",
      "services/**/*.ts",
      "models/**/*.ts",
      "fixtures/**/*.ts",
      "utils/**/*.ts",
      "tests/**/*.ts"
    ],
    "exclude": ["node_modules", "dist"]
  }
